                  "block_id": {
                    "type": "string",
                    "pattern": "^block_[a-z0-9_-]{1,60}$"
                  },
                  "block_type": {
                    "type": "string",
                    "enum": [
                      "hook",
                      "problem",
                      "analysis",
                      "step",
                      "example",
                      "evidence",
                      "acceptance",
                      "failure",
                      "boundary",
                      "cta"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 6000
                  },
                  "claim_ids": {
                    "maxItems": 8,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^claim_[a-z0-9_-]{1,60}$"
                    }
                  },
                  "experiment_refs": {
                    "maxItems": 2,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "baseline_chat_request",
                        "structured_task_card"
                      ]
                    }
                  },
                  "product_claim_ids": {
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "persona_fact_ids": {
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "style_rule_ids": {
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Z]{3}-\\d{2}$|^PLATFORM-[A-Z0-9-]+$"
                    }
                  },
                  "is_opinion": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "block_id",
                  "block_type",
                  "text",
                  "claim_ids",
                  "experiment_refs",
                  "product_claim_ids",
                  "persona_fact_ids",
                  "style_rule_ids",
                  "is_opinion"
                ],
                "additionalProperties": false
              }
            },
            "article_markdown": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50000
            },
            "chinese_character_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "source_notes": {
              "maxItems": 8,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "url": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uri"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "support_status": {
                    "type": "string",
                    "enum": [
                      "direct",
                      "partial"
                    ]
                  },
                  "scope_limit": {
                    "type": "string",
                    "maxLength": 1000
                  }
                },
                "required": [
                  "title",
                  "url",
                  "support_status",
                  "scope_limit"
                ],
                "additionalProperties": false
              }
            },
            "cta": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "none",
                    "light"
                  ]
                },
                "text": {
                  "type": "string",
                  "maxLength": 1000
                }
              },
              "required": [
                "mode",
                "text"
              ],
              "additionalProperties": false
            },
            "visual_slots": {
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "slot_id": {
                    "type": "string",
                    "pattern": "^visual_[a-z0-9_-]{1,60}$"
                  },
                  "location": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "purpose": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "visual_type": {
                    "type": "string",
                    "enum": [
                      "cover",
                      "process_diagram",
                      "checklist",
                      "comparison",
                      "screenshot",
                      "result_card"
                    ]
                  },
                  "required_evidence_refs": {
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "caption": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "generation_status": {
                    "type": "string",
                    "const": "not_started"
                  }
                },
                "required": [
                  "slot_id",
                  "location",
                  "purpose",
                  "visual_type",
                  "required_evidence_refs",
                  "caption",
                  "generation_status"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "primary_title",
            "alternative_titles",
            "abstract",
            "article_type",
            "blocks",
            "article_markdown",
            "chinese_character_count",
            "source_notes",
            "cta",
            "visual_slots"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "x": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "format": {
              "type": "string",
              "enum": [
                "single_post",
                "thread",
                "debate_prompt"
              ]
            },
            "single_post": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 500
                },
                {
                  "type": "null"
                }
              ]
            },
            "thread": {
              "maxItems": 7,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
