{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/writing-pack.schema.json",
  "title": "Evidence-constrained Writing Pack",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "writing_date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^writing_[0-9T_-]+Z$"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed"
      ]
    },
    "decision": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "READY_FOR_HUMAN_REVIEW",
            "BLOCKED_BY_RESEARCH",
            "NO_CONTENT",
            "WAITING_FOR_RESEARCH",
            "WAITING_FOR_APPROVED_STYLE"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "synthetic_fixture": {
      "type": "boolean"
    },
    "not_for_publication": {
      "type": "boolean"
    },
    "research": {
      "type": "object",
      "properties": {
        "research_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "research_input_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "research_decision": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "READY_FOR_WRITING",
                "RESEARCH_INCOMPLETE",
                "NO_TOPIC"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "topic_signature": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "research_run_id",
        "research_input_hash",
        "research_decision",
        "topic_signature"
      ],
      "additionalProperties": false
    },
    "style": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "style_status": {
              "type": "string",
              "enum": [
                "provisional_approved_with_pending_items",
                "approved"
              ]
            },
            "approval_chain_status": {
              "type": "string",
              "enum": [
                "valid_v2_receipt",
                "valid_legacy_receipt_with_binding_attestation"
              ]
            },
            "provisional_style_used": {
              "type": "boolean"
            },
            "production_eligible": {
              "type": "boolean"
            },
            "profile_ids": {
              "type": "object",
              "properties": {
                "owner": {
                  "type": "string"
                },
                "reference": {
                  "type": "string"
                },
                "provisional": {
                  "type": "string"
                }
              },
              "required": [
                "owner",
                "reference",
                "provisional"
              ],
              "additionalProperties": false
            },
            "profile_versions": {
              "type": "object",
              "properties": {
                "provisional": {
                  "type": "number",
                  "const": 1
                }
              },
              "required": [
                "provisional"
              ],
              "additionalProperties": false
            },
            "profile_hashes": {
              "type": "object",
              "properties": {
                "owner": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "reference": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "provisional": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "owner",
                "reference",
                "provisional"
              ],
              "additionalProperties": false
            },
            "receipt_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "attestation_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "decision_set_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "recipe_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "selected_rule_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z]{3}-\\d{2}$|^PLATFORM-[A-Z0-9-]+$"
              }
            },
            "excluded_rule_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z]{3}-\\d{2}$|^PLATFORM-[A-Z0-9-]+$"
              }
            },
            "deleted_rule_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z]{3}-\\d{2}$|^PLATFORM-[A-Z0-9-]+$"
              }
            },
            "owner_profile_scope": {
              "type": "string",
              "const": "owner_shortform_social_proxy"
            },
            "platform_fidelity": {
              "type": "string",
              "const": "proxy"
            },
            "confidence": {
              "type": "string",
              "const": "medium"
            }
          },
          "required": [
            "style_status",
            "approval_chain_status",
            "provisional_style_used",
            "production_eligible",
            "profile_ids",
            "profile_versions",
            "profile_hashes",
            "receipt_sha256",
            "attestation_sha256",
            "decision_set_sha256",
            "recipe_hash",
            "selected_rule_ids",
            "excluded_rule_ids",
            "deleted_rule_ids",
            "owner_profile_scope",
            "platform_fidelity",
            "confidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "master_draft": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "article_type": {
              "type": "string",
              "enum": [
                "tutorial",
                "analysis",
                "case_breakdown",
                "opinion",
                "checklist"
              ]
            },
            "blocks": {
              "minItems": 1,
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "block_id": {
                    "type": "string",
                    "pattern": "^block_[a-z0-9_-]{1,60}$"
                  },
                  "block_type": {
                    "type": "string",
                    "enum": [
                      "hook",
                      "problem",
                      "analysis",
                      "step",
                      "example",
                      "evidence",
                      "acceptance",
                      "failure",
                      "boundary",
                      "cta"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 6000
                  },
                  "claim_ids": {
                    "maxItems": 8,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^claim_[a-z0-9_-]{1,60}$"
                    }
                  },
                  "experiment_refs": {
                    "maxItems": 2,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "baseline_chat_request",
                        "structured_task_card"
                      ]
                    }
                  },
                  "product_claim_ids": {
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "persona_fact_ids": {
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "style_rule_ids": {
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Z]{3}-\\d{2}$|^PLATFORM-[A-Z0-9-]+$"
                    }
                  },
                  "is_opinion": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "block_id",
                  "block_type",
                  "text",
                  "claim_ids",
                  "experiment_refs",
                  "product_claim_ids",
                  "persona_fact_ids",
                  "style_rule_ids",
                  "is_opinion"
                ],
                "additionalProperties": false
              }
            },
            "rendered_markdown": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50000
            }
          },
          "required": [
            "article_type",
            "blocks",
            "rendered_markdown"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "wechat": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "primary_title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "alternative_titles": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              ]
            },
            "abstract": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "article_type": {
              "type": "string",
