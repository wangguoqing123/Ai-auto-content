            "why_now": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "proof_format": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "time_sensitive": {
              "type": "boolean"
            },
            "fact_source_ids": {
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^mat_[a-f0-9]{12}$"
              }
            },
            "trend_signal_ids": {
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^mat_[a-f0-9]{12}$"
              }
            },
            "structure_inspiration_ids": {
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^mat_[a-f0-9]{12}$"
