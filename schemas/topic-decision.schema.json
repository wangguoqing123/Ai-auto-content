                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "cta_mode": {
              "type": "string",
              "enum": [
                "none",
                "light",
                "club"
              ]
            },
            "product_claim_ids": {
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              }
