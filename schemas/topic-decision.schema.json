{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/topic-decision.schema.json",
  "title": "Daily Topic Intelligence Decision",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "decision_date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^topic_[0-9T_-]+Z$"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed"
      ]
    },
    "decision": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "SELECT_TOPIC",
            "NO_PUBLISH"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_summary": {
      "type": "object",
      "properties": {
        "total_before_filter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "total_after_filter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cloud_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "twitter_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "weixin_resolved_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "restricted_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fact_source_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "trend_signal_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "structure_inspiration_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "source_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "browser_missing",
              "cloud_missing"
            ]
          }
        }
      },
      "required": [
        "total_before_filter",
        "total_after_filter",
        "cloud_count",
        "twitter_count",
        "weixin_resolved_count",
        "restricted_count",
        "fact_source_count",
        "trend_signal_count",
        "structure_inspiration_count",
        "source_gaps"
      ],
      "additionalProperties": false
    },
    "selected_topic": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "candidate_id": {
              "type": "string",
              "pattern": "^candidate_[a-z0-9_-]{1,50}$"
            },
            "working_title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "one_sentence_promise": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "target_segment": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "learner_stage": {
              "type": "string",
              "enum": [
                "concept_confusion",
                "tool_selection",
                "unstable_usage",
                "task_breakdown",
                "workflow_building",
                "project_delivery",
                "continuous_improvement",
                "business_integration"
              ]
            },
            "trigger_scenario": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "user_problem": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
