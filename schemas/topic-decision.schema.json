            "primary_product_module_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_]*$"
            },
            "supporting_product_module_ids": {
              "maxItems": 5,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9_]*$"
              }
            },
            "funnel_role": {
              "type": "string",
              "enum": [
                "traffic",
                "trust",
                "lead_generation"
              ]
            },
            "core_angle": {
