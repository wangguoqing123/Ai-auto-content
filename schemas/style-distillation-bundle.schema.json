{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/style-distillation-bundle.schema.json",
  "title": "Style Distillation Bundle",
  "type": "object",
  "properties": {
    "profile_fragment": {
      "type": "object",
      "properties": {
        "voice_signals": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "structural_patterns": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "explanation_patterns": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "evidence_patterns": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "cta_patterns": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "positive_rules": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "anti_patterns": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "preferred_terms": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "content_pattern_profile": {
          "type": "object",
          "properties": {
            "topic_entries": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "problem_definitions": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "evidence_placement": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "progression_patterns": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "ending_patterns": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          },
          "required": [
            "topic_entries",
            "problem_definitions",
            "evidence_placement",
            "progression_patterns",
            "ending_patterns"
          ],
          "additionalProperties": false
        },
        "language_style_profile": {
          "type": "object",
          "properties": {
            "rhythm_observations": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "first_person_usage": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "question_usage": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "transition_patterns": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "abstraction_and_action": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "judgment_and_uncertainty": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "humor_and_asides": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          },
          "required": [
            "rhythm_observations",
            "first_person_usage",
            "question_usage",
            "transition_patterns",
            "abstraction_and_action",
            "judgment_and_uncertainty",
            "humor_and_asides"
          ],
          "additionalProperties": false
        },
        "conversion_pattern_profile": {
          "type": "object",
          "properties": {
            "cta_positions": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "cta_length_patterns": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "free_value_completeness": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "product_connections": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "anxiety_patterns": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            },
            "omitted_step_patterns": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          },
          "required": [
            "cta_positions",
            "cta_length_patterns",
            "free_value_completeness",
            "product_connections",
            "anxiety_patterns",
            "omitted_step_patterns"
          ],
          "additionalProperties": false
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "voice_signals",
        "structural_patterns",
        "explanation_patterns",
        "evidence_patterns",
        "cta_patterns",
        "positive_rules",
        "anti_patterns",
        "preferred_terms",
        "content_pattern_profile",
        "language_style_profile",
        "conversion_pattern_profile",
        "confidence"
      ],
      "additionalProperties": false
    },
    "protected_transfer_candidates": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "signature_phrase",
              "unique_metaphor",
              "personal_experience_entity",
              "distinctive_short_fragment"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "source_document_ids": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^doc_[a-f0-9]{16}$"
            }
          },
          "extraction_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          }
        },
        "required": [
          "kind",
          "text",
          "source_document_ids",
          "extraction_reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "profile_fragment",
    "protected_transfer_candidates"
  ],
  "additionalProperties": false
}
