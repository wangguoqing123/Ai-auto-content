{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/material-card.schema.json",
  "title": "Daily Material Record",
  "type": "object",
  "required": [
    "material_id",
    "source_platform",
    "source_kind",
    "collector",
    "query_id",
    "query_text",
    "search_rank",
    "source_item_id",
    "author_name",
    "author_followers",
    "source_id",
    "source_name",
    "source_type",
    "source_tier",
    "category",
    "title",
    "source_url",
    "content_path",
    "canonical_url",
    "author",
    "published_at",
    "published_at_quality",
    "collected_at",
    "engagement",
    "metric_quality",
    "usage_mode",
    "viral_confidence",
    "language",
    "excerpt",
    "target_users",
    "tags",
    "relevance_score",
    "freshness_score",
    "evidence_score",
    "overall_score",
    "fingerprint",
    "content_fingerprint",
    "status",
    "rejection_reasons"
  ],
  "properties": {
    "material_id": {"type": "string", "pattern": "^mat_[a-f0-9]{12}$"},
    "source_platform": {"enum": ["twitter", "xiaohongshu", "weixin", "aihot", "rss"]},
    "source_kind": {"enum": ["official", "news", "ugc"]},
    "collector": {"type": "string"},
    "query_id": {"type": "string"},
    "query_text": {"type": "string"},
    "search_rank": {"type": ["integer", "null"], "minimum": 1},
    "source_item_id": {"type": "string"},
    "author_name": {"type": "string"},
    "author_followers": {"type": ["integer", "null"], "minimum": 0},
    "source_id": {"type": "string"},
    "source_name": {"type": "string"},
    "source_type": {"enum": ["rss", "opencli", "api"]},
    "source_tier": {"enum": ["primary", "secondary", "unverified"]},
    "category": {"type": "string"},
    "title": {"type": "string"},
    "source_url": {"type": "string"},
    "content_path": {"type": ["string", "null"]},
    "canonical_url": {"type": "string"},
    "author": {"type": ["string", "null"]},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "published_at_quality": {"enum": ["exact", "inferred", "unknown"]},
    "collected_at": {"type": "string", "format": "date-time"},
    "engagement": {
      "type": "object",
      "required": ["views", "likes", "comments", "shares", "reposts", "quotes", "bookmarks", "collects"],
      "properties": {
        "views": {"type": ["integer", "null"], "minimum": 0},
        "likes": {"type": ["integer", "null"], "minimum": 0},
        "comments": {"type": ["integer", "null"], "minimum": 0},
        "shares": {"type": ["integer", "null"], "minimum": 0},
        "reposts": {"type": ["integer", "null"], "minimum": 0},
        "quotes": {"type": ["integer", "null"], "minimum": 0},
        "bookmarks": {"type": ["integer", "null"], "minimum": 0},
        "collects": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "metric_quality": {"enum": ["complete", "partial", "unavailable"]},
    "usage_mode": {"enum": ["fact_source", "trend_signal", "structure_inspiration", "reference_only"]},
    "viral_confidence": {"enum": ["verified", "likely", "candidate", "unverified"]},
    "language": {"type": "string"},
    "excerpt": {"type": "string", "maxLength": 1000},
    "target_users": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "relevance_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "freshness_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "evidence_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "overall_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "content_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["accepted", "rejected", "quarantined"]},
    "rejection_reasons": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
