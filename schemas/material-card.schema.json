{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/material-card.schema.json",
  "title": "Daily Material Record",
  "type": "object",
  "required": [
    "material_id",
    "source_id",
    "source_name",
    "source_type",
    "source_tier",
    "category",
    "title",
    "source_url",
    "canonical_url",
    "author",
    "published_at",
    "collected_at",
    "language",
    "excerpt",
    "target_users",
    "tags",
    "relevance_score",
    "freshness_score",
    "evidence_score",
    "overall_score",
    "fingerprint",
    "content_fingerprint",
    "status",
    "rejection_reasons"
  ],
  "properties": {
    "material_id": {"type": "string", "pattern": "^mat_[a-f0-9]{12}$"},
    "source_id": {"type": "string"},
    "source_name": {"type": "string"},
    "source_type": {"const": "rss"},
    "source_tier": {"enum": ["primary", "secondary", "unverified"]},
    "category": {"type": "string"},
    "title": {"type": "string"},
    "source_url": {"type": "string"},
    "canonical_url": {"type": "string"},
    "author": {"type": ["string", "null"]},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "collected_at": {"type": "string", "format": "date-time"},
    "language": {"type": "string"},
    "excerpt": {"type": "string", "maxLength": 1000},
    "target_users": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}},
    "relevance_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "freshness_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "evidence_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "overall_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "content_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["accepted", "rejected"]},
    "rejection_reasons": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
