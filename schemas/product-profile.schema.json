{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/product-profile.schema.json",
  "title": "AI Never Fall Behind Product Profile",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 2
    },
    "updated_at": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "evidence_basis": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      }
    },
    "product": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "brand_line": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "product_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        }
      },
      "required": [
        "id",
        "name",
        "brand_line",
        "owner",
        "product_type"
      ],
      "additionalProperties": false
    },
    "positioning": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "string",
          "minLength": 1
        },
        "core_promise": {
          "type": "string",
          "minLength": 1
        },
        "transformation": {
          "type": "object",
          "properties": {
            "from": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "to": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        "final_goal": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "primary",
        "core_promise",
        "transformation",
        "final_goal"
      ],
      "additionalProperties": false
    },
    "audience": {
      "type": "object",
      "properties": {
        "primary": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "suitable_for": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "not_suitable_for": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "primary",
        "suitable_for",
        "not_suitable_for"
      ],
      "additionalProperties": false
    },
    "learning_method": {
      "type": "object",
      "properties": {
        "first_use_instruction": {
          "type": "string",
          "minLength": 1
        },
        "principles": {
          "minItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9_]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "name",
              "explanation"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "first_use_instruction",
        "principles"
      ],
      "additionalProperties": false
    },
    "mechanisms": {
      "minItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "facts": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "name",
          "facts",
          "constraints"
        ],
        "additionalProperties": false
      }
    },
    "learning_architecture": {
      "type": "object",
      "properties": {
        "shared_foundation": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9_]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "topics": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "name",
              "topics"
            ],
            "additionalProperties": false
          }
        },
        "practice_tracks": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z0-9][a-z0-9_]*$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "module_ids": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9][a-z0-9_]*$"
                }
              }
            },
            "required": [
              "id",
              "name",
              "description",
              "module_ids"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "shared_foundation",
        "practice_tracks"
      ],
      "additionalProperties": false
    },
    "delivery_catalog": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "delivery_status": {
            "type": "string",
            "enum": [
              "confirmed_delivered",
              "confirmed_container",
              "confirmed_partial",
              "direction_confirmed_delivery_unverified",
              "unknown"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence_basis": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            }
          },
          "confirmed_items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "visible_topics": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "product_value": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "delivery_status",
          "description",
          "evidence_basis",
          "confirmed_items",
          "visible_topics",
          "constraints",
          "product_value"
        ],
        "additionalProperties": false
      }
    },
    "pricing": {
      "type": "object",
      "properties": {
        "currency": {
          "type": "string",
          "const": "CNY"
        },
        "billing_period": {
          "type": "string",
          "const": "year"
        },
        "current_offer": {
          "type": "object",
          "properties": {
            "price_cny": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "status": {
              "type": "string",
              "const": "user_confirmed_current"
            },
            "verified_at": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            "requires_refresh_before_public_sales_content": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "price_cny",
            "status",
            "verified_at",
            "requires_refresh_before_public_sales_content"
          ],
          "additionalProperties": false
        },
        "standard_price": {
          "type": "object",
          "properties": {
            "price_cny": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            }
          },
          "required": [
            "price_cny",
            "source"
          ],
          "additionalProperties": false
        },
        "early_bird": {
          "type": "object",
          "properties": {
            "first_member_limit": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "remaining_slots": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "current_member_index": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "exact_remaining_claim_allowed": {
              "type": "boolean",
              "const": false
            },
            "countdown_claim_allowed": {
              "type": "boolean",
              "const": false
            }
          },
          "required": [
            "first_member_limit",
            "remaining_slots",
            "current_member_index",
            "exact_remaining_claim_allowed",
            "countdown_claim_allowed"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "currency",
        "billing_period",
        "current_offer",
        "standard_price",
        "early_bird"
      ],
      "additionalProperties": false
    },
    "claims": {
      "type": "object",
      "properties": {
        "confirmed": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        },
        "evidence_required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        },
        "forbidden": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        }
      },
      "required": [
        "confirmed",
        "evidence_required",
        "forbidden"
      ],
      "additionalProperties": false
    },
    "unknown_fields": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      }
    }
  },
  "required": [
    "version",
    "updated_at",
    "evidence_basis",
    "product",
    "positioning",
    "audience",
    "learning_method",
    "mechanisms",
    "learning_architecture",
    "delivery_catalog",
    "pricing",
    "claims",
    "unknown_fields"
  ],
  "additionalProperties": false
}
