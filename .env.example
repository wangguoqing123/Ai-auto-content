AIHOT_ACTOR_ID=
# Daily topic intelligence production runtime: the locally authenticated Codex CLI.
TOPIC_LLM_PROVIDER=codex_cli
TOPIC_CODEX_BIN=
TOPIC_CODEX_MODEL=

# Research Pack reuses the same authenticated Codex CLI. Model remains explicit.
RESEARCH_CODEX_BIN=
RESEARCH_CODEX_MODEL=

# Simple Writing uses exactly one Codex CLI Writer call after a selected topic has usable persisted sources.
# WRITING_CODEX_BIN / WRITING_CODEX_MODEL remain compatible fallbacks.
SIMPLE_WRITING_CODEX_BIN=
SIMPLE_WRITING_CODEX_MODEL=gpt-5.6-sol

# Optional API fallback only; not required by the production Local Runtime.
# TOPIC_LLM_PROVIDER=openai
# TOPIC_LLM_MODEL=
# OPENAI_API_KEY=
# TOPIC_LLM_BASE_URL=
