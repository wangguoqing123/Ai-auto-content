{"material_id":"mat_0ae360bdbb1e","source_platform":"aihot","source_kind":"news","collector":"aihot-v1","query_id":"","query_text":"","search_rank":null,"source_item_id":"uinaiwkzg4u2exkfgv4oha9p7","identity_aliases":[],"source_access_status":"resolved","author_name":"X：Addy Osmani (@addyosmani)","author_followers":null,"title":"Addy Osmani 谈 Agent 时代如何保持批判性思维","excerpt":"Addy Osmani 发文探讨在大量使用 Agent 工作流后如何保持批判性思维。他提出认知卸载、拖延、认知投降三段光谱，认为模型越强、输出越流畅，人越容易在不知不觉中放弃独立判断；并给出具体做法，包括提问前先写假设、把验证标准前置为可执行测试、要求 Agent 列出它替你做的决策与假设、用测验收尾而不是读摘要，以及定期手写代码做校准练习。他强调可以卸载工作和审计，但不能卸载责任。","source_url":"https://x.com/addyosmani/status/2117512471930167377","canonical_url":"https://x.com/addyosmani/status/2117512471930167377","content_path":null,"content_downloaded":false,"published_at":"2026-11-03T07:01:29.000Z","published_at_quality":"exact","collected_at":"2026-11-03T07:42:21.473Z","engagement":{"views":null,"likes":null,"comments":null,"shares":null,"reposts":null,"quotes":null,"bookmarks":null,"collects":null},"metric_quality":"unavailable","usage_mode":"reference_only","viral_confidence":"unverified","status":"accepted","rejection_reasons":[],"source_id":"aihot-selected-24h","source_name":"AIHOT 24 小时精选","source_type":"api","source_tier":"secondary","category":"ai_news","author":"X：Addy Osmani (@addyosmani)","language":"zh","target_users":["ai_beginner","intermediate_user"],"tags":["ai_basics","ai_news","work_task"],"relevance_score":50,"freshness_score":100,"evidence_score":70,"overall_score":68,"fingerprint":"0ae360bdbb1ea522bbe677f0e7e580c7f75f76903cb51d246aaf73a858ee00cc","content_fingerprint":"4090986c43f99a35f66d7a38ef6d59850237327ac760ff8aaa0ca51bd03f8527"}
