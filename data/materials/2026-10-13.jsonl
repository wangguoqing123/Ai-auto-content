{"material_id":"mat_a53bd9c7aa11","source_platform":"aihot","source_kind":"news","collector":"aihot-v1","query_id":"","query_text":"","search_rank":null,"source_item_id":"svvvhr5j2nnywgdw29pso7o49","identity_aliases":[],"source_access_status":"resolved","author_name":"X：Meshy (@MeshyAI)","author_followers":null,"title":"用 Claude Opus 5.5、Blender、Unreal Engine 和 Meshy 构建游戏的七步教程","excerpt":"一篇教程介绍用 Claude Opus 5.5 配合 Claude Code、Blender、Unreal Engine 5 和 Meshy 构建游戏的方法。核心思路是给每个工具分配单一职责：通过 MCP 连接 Blender 和 Meshy，由 Meshy 生成道具和角色、Blender 清理和放置、Unreal 负责光照物理和游戏本身、Opus 在一个对话里调度三者。流程为先让 Opus 头脑风暴 5 个游戏点子再展开，告知 GPU 以便压满画面性能，首个完整构建约花 4 小时和约 19% 的每周 Max plan 用量，之后因素材复用会快很多。","source_url":"https://x.com/MeshyAI/status/2109550836934471864","canonical_url":"https://x.com/MeshyAI/status/2109550836934471864","content_path":null,"content_downloaded":false,"published_at":"2026-10-12T07:44:47.000Z","published_at_quality":"exact","collected_at":"2026-10-13T07:28:29.471Z","engagement":{"views":null,"likes":null,"comments":null,"shares":null,"reposts":null,"quotes":null,"bookmarks":null,"collects":null},"metric_quality":"unavailable","usage_mode":"reference_only","viral_confidence":"unverified","status":"accepted","rejection_reasons":[],"source_id":"aihot-selected-24h","source_name":"AIHOT 24 小时精选","source_type":"api","source_tier":"secondary","category":"ai_news","author":"X：Meshy (@MeshyAI)","language":"zh","target_users":["ai_beginner","intermediate_user"],"tags":["ai_basics","ai_coding","ai_news","beginner"],"relevance_score":62,"freshness_score":100,"evidence_score":70,"overall_score":74,"fingerprint":"a53bd9c7aa111ed5980ba0155c2961fcc6f933f8cbc96fcc6782c9e6262295f2","content_fingerprint":"54a57440865fc6709b2d9a6d52d4a1da06102d55050b2d25bfde2bcdabcbeb89"}
