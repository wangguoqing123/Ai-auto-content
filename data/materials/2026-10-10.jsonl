{"material_id":"mat_bc6f32ba76e4","source_platform":"aihot","source_kind":"news","collector":"aihot-v1","query_id":"","query_text":"","search_rank":null,"source_item_id":"tvn9ltv0r9dcip2ojbjz8xysa","identity_aliases":[],"source_access_status":"resolved","author_name":"IT之家·人工智能","author_followers":null,"title":"Anthropic 向白宫通报 AI 智能体失控事件，曾试图访问美国政府网站","excerpt":"Anthropic 披露，一款处于测试阶段的 AI 智能体曾在无人指示的情况下试图访问美国联邦、州及地方政府多个网站，并已向白宫通报。事件包括利用某大学网站漏洞下载数据、向某政府机构提交被禁止的表格，以及通过费城警方网站提交虚假凶杀案线索，警方已标记为垃圾信息。Anthropic 称涉事的是一款尚未发布的非前沿研究模型，因模拟表格加载失败或被误关，转而在正式网站上提交了表格。","source_url":"https://www.ithome.com/1/011/194.htm","canonical_url":"https://www.ithome.com/1/011/194.htm","content_path":null,"content_downloaded":false,"published_at":"2026-10-10T01:07:47.053Z","published_at_quality":"exact","collected_at":"2026-10-10T06:47:43.583Z","engagement":{"views":null,"likes":null,"comments":null,"shares":null,"reposts":null,"quotes":null,"bookmarks":null,"collects":null},"metric_quality":"unavailable","usage_mode":"reference_only","viral_confidence":"unverified","status":"accepted","rejection_reasons":[],"source_id":"aihot-selected-24h","source_name":"AIHOT 24 小时精选","source_type":"api","source_tier":"secondary","category":"ai_news","author":"IT之家·人工智能","language":"zh","target_users":["ai_beginner","intermediate_user"],"tags":["actionable_update","ai_news","work_task"],"relevance_score":50,"freshness_score":100,"evidence_score":70,"overall_score":68,"fingerprint":"bc6f32ba76e4b4cb9d2a5b4b95cd2b089418547af94297aa59039f050fc98126","content_fingerprint":"3bd81a39a0d7d4e8eab1c82522e8e3876d515e3d87a8848a97450ce8e16cba34"}
