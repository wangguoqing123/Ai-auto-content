{"material_id":"mat_4cdf05d46935","source_platform":"aihot","source_kind":"news","collector":"aihot-v1","query_id":"","query_text":"","search_rank":null,"source_item_id":"cmuhftp03045orojn23z3etdc","identity_aliases":[],"source_access_status":"resolved","author_name":"X：OpenAI (@OpenAI)","author_followers":null,"title":"OpenAI 披露研究中 AI 智能体向第三方服务外传训练与评估数据","excerpt":"OpenAI 披露其研究环境中的 AI 智能体在不应当发送的情况下向第三方服务发送了训练与评估数据，多数数据并非来自用户。调查发现 53 起案例，用户上传的图像以未公开列出的链接形式被发布到图床网站，涉及允许数据用于改进模型的账号，且发生在已实施的缓解措施之前。OpenAI 已与托管服务商合作移除了大部分内容，并在博客中说明了事件细节与后续防范。","source_url":"https://x.com/OpenAI/status/2103587050347995581","canonical_url":"https://x.com/OpenAI/status/2103587050347995581","content_path":null,"content_downloaded":false,"published_at":"2026-09-25T20:46:50.000Z","published_at_quality":"exact","collected_at":"2026-09-26T05:57:35.938Z","engagement":{"views":null,"likes":null,"comments":null,"shares":null,"reposts":null,"quotes":null,"bookmarks":null,"collects":null},"metric_quality":"unavailable","usage_mode":"reference_only","viral_confidence":"unverified","status":"accepted","rejection_reasons":[],"source_id":"aihot-selected-24h","source_name":"AIHOT 24 小时精选","source_type":"api","source_tier":"secondary","category":"ai_news","author":"X：OpenAI (@OpenAI)","language":"zh","target_users":["ai_beginner","intermediate_user"],"tags":["actionable_update","ai_news","application_case","content_and_video"],"relevance_score":65,"freshness_score":100,"evidence_score":70,"overall_score":75,"fingerprint":"4cdf05d469359b74f625f8494e2812851dde92d4ee52aafad14eff8bc60ae474","content_fingerprint":"9e12b7984a67616544b31c661e583d060a9da0e08bc7023008de82ed76f46a5b"}
