{"material_id":"mat_e23fae26ca17","source_platform":"aihot","source_kind":"news","collector":"aihot-v1","query_id":"","query_text":"","search_rank":null,"source_item_id":"cmu7b4t69044mrogrg7zn0p8h","identity_aliases":[],"source_access_status":"resolved","author_name":"Hacker News：AI 热帖","author_followers":null,"title":"美军因 AI 幻觉情报报告险些拦截中国船只","excerpt":"据 CNN 报道，今年春天美伊战争期间，一份由特种作战司令部分析师借助聊天机器人生成的情报报告错误称一艘中东中国船只运输核武器部件，美军一度准备武装登船拦截，行动前才发现报告内容完全不实。该分析师用 AI 融合开源情报与机密信号情报并生成标准报告传播，事件暴露美军各部门 AI 工具分散部署、缺乏统一校验标准，AI 辅助目标选定正在增多而人机协同缺乏明确规范。","source_url":"https://www.cnn.com/2026/09/18/politics/us-military-ai-false-intelligence-china-ship","canonical_url":"https://www.cnn.com/2026/09/18/politics/us-military-ai-false-intelligence-china-ship","content_path":null,"content_downloaded":false,"published_at":"2026-09-18T17:28:01.000Z","published_at_quality":"exact","collected_at":"2026-09-19T05:33:49.143Z","engagement":{"views":null,"likes":null,"comments":null,"shares":null,"reposts":null,"quotes":null,"bookmarks":null,"collects":null},"metric_quality":"unavailable","usage_mode":"reference_only","viral_confidence":"unverified","status":"rejected","rejection_reasons":["low_relevance"],"source_id":"aihot-selected-24h","source_name":"AIHOT 24 小时精选","source_type":"api","source_tier":"secondary","category":"ai_news","author":"Hacker News：AI 热帖","language":"zh","target_users":["ai_beginner","intermediate_user"],"tags":["ai_news","content_and_video"],"relevance_score":40,"freshness_score":100,"evidence_score":70,"overall_score":63,"fingerprint":"e23fae26ca174658c119cd467cd5f5834b5098661c753feadab4a8292cdbeccf","content_fingerprint":"e3b2fb36504daa917e5c746a8f158a4a7212fbcf808622c13ba66ee4cd49085f"}
