{"material_id":"mat_ba727db8a280","source_platform":"aihot","source_kind":"news","collector":"aihot-v1","query_id":"","query_text":"","search_rank":null,"source_item_id":"sah26a5ofgvrxd76bgj9t77wf","identity_aliases":[],"source_access_status":"resolved","author_name":"X：Tibo (@thsottiaux)","author_followers":null,"title":"OpenAI Codex 团队成员解释 6.2 Sol/Astra 评测视频与现场反馈的差异","excerpt":"Tibo 解释 6.2 Sol/Astra 上评测视频与现场人群反馈氛围不同的原因：部分人较早获得访问权限，而团队在过去 3-4 天做了大量改动，视频是上周制作的，之后大概率没有重新测试。他称这两个模型相比 GPT 前代有明显提升，但仍不完美，团队希望在后续迭代的品味和使用体验上改进，并表示欢迎反馈。","source_url":"https://x.com/thsottiaux/status/2122929634916679820","canonical_url":"https://x.com/thsottiaux/status/2122929634916679820","content_path":null,"content_downloaded":false,"published_at":"2026-11-18T05:47:21.000Z","published_at_quality":"exact","collected_at":"2026-11-18T08:18:38.697Z","engagement":{"views":null,"likes":null,"comments":null,"shares":null,"reposts":null,"quotes":null,"bookmarks":null,"collects":null},"metric_quality":"unavailable","usage_mode":"reference_only","viral_confidence":"unverified","status":"rejected","rejection_reasons":["low_relevance"],"source_id":"aihot-selected-24h","source_name":"AIHOT 24 小时精选","source_type":"api","source_tier":"secondary","category":"ai_news","author":"X：Tibo (@thsottiaux)","language":"zh","target_users":["ai_beginner","intermediate_user"],"tags":["ai_news","content_and_video"],"relevance_score":40,"freshness_score":100,"evidence_score":70,"overall_score":63,"fingerprint":"ba727db8a280cb86ea36d8563fac5c15e08a3ca1ad333c914a246147ef130241","content_fingerprint":"9a637c0ef354658865effe546e870106a495df9d50deed7a83e53b5852febf91"}
