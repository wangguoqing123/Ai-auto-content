{"material_id":"mat_e68246067eed","source_platform":"aihot","source_kind":"news","collector":"aihot-v1","query_id":"","query_text":"","search_rank":null,"source_item_id":"cmstc3u8j02xhro0xf5o1ouas","identity_aliases":[],"source_access_status":"resolved","author_name":"Anthropic：Newsroom（网页）","author_followers":null,"title":"Claude 文本水印机制如何运作","excerpt":"未来 Claude 模型生成的文本将包含水印，用于判断文本由 Claude 撰写的可能性，这是 Anthropic 为遵守欧盟《AI 法案》而实施的变更。该方法基于 Google DeepMind 的 SynthID-Text 技术，对输出质量、创造力和可读性无实际影响，读者无法区分水印文本与普通文本，且不增加额外 token 或成本。","source_url":"https://www.anthropic.com/news/claude-text-watermark","canonical_url":"https://www.anthropic.com/news/claude-text-watermark","content_path":null,"content_downloaded":false,"published_at":"2026-08-14T19:22:48.546Z","published_at_quality":"exact","collected_at":"2026-08-15T02:15:00.298Z","engagement":{"views":null,"likes":null,"comments":null,"shares":null,"reposts":null,"quotes":null,"bookmarks":null,"collects":null},"metric_quality":"unavailable","usage_mode":"reference_only","viral_confidence":"unverified","status":"rejected","rejection_reasons":["low_relevance"],"source_id":"aihot-selected-24h","source_name":"AIHOT 24 小时精选","source_type":"api","source_tier":"secondary","category":"ai_news","author":"Anthropic：Newsroom（网页）","language":"zh","target_users":["ai_beginner","intermediate_user"],"tags":["ai_basics","ai_news"],"relevance_score":35,"freshness_score":100,"evidence_score":70,"overall_score":60,"fingerprint":"e68246067eeddf6e1d69054b26875df87dd7d6bd47ff2b0a5e4c670c0aaa6059","content_fingerprint":"c9395d83590e833fcbb32ad3429d1c44e8516589cd4c7250e65f6a8f7fd1d5f9"}
