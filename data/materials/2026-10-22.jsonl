{"material_id":"mat_a1c00e405b7e","source_platform":"aihot","source_kind":"news","collector":"aihot-v1","query_id":"","query_text":"","search_rank":null,"source_item_id":"eud25k8zsrrwc63xp39ptvfah","identity_aliases":[],"source_access_status":"resolved","author_name":"X：Rohan Paul (@rohanpaul_ai)","author_followers":null,"title":"Bloomberg 报道 DeepSeek 新一轮融资约 150 亿美元","excerpt":"据 Bloomberg，DeepSeek 最新一轮融资约 150 亿美元，为中国最大规模私募融资之一。谈判期间融资目标至少两次上调，从约 75 亿美元提高到 120 亿美元；CATL 和腾讯是最大投资方之一，CATL 据报出资约 15 亿美元。投前估值约 748 亿美元，加上 6 月完成的首轮超 75 亿美元，DeepSeek 约 6 个月内共募资约 225 亿美元。","source_url":"https://x.com/rohanpaul_ai/status/2113106318659928525","canonical_url":"https://x.com/rohanpaul_ai/status/2113106318659928525","content_path":null,"content_downloaded":false,"published_at":"2026-10-22T03:13:00.000Z","published_at_quality":"exact","collected_at":"2026-10-22T05:51:27.074Z","engagement":{"views":null,"likes":null,"comments":null,"shares":null,"reposts":null,"quotes":null,"bookmarks":null,"collects":null},"metric_quality":"unavailable","usage_mode":"reference_only","viral_confidence":"unverified","status":"rejected","rejection_reasons":["low_relevance","below_overall_threshold"],"source_id":"aihot-selected-24h","source_name":"AIHOT 24 小时精选","source_type":"api","source_tier":"secondary","category":"ai_news","author":"X：Rohan Paul (@rohanpaul_ai)","language":"zh","target_users":["ai_beginner","intermediate_user"],"tags":["ai_news"],"relevance_score":25,"freshness_score":100,"evidence_score":70,"overall_score":55,"fingerprint":"a1c00e405b7e56d61926739f8ab0d0e89bd7dd1aca61d5c2ce25f5ae1de000c2","content_fingerprint":"bde1b49b7182158e70833c2489266ad0d50f229b031af7ec8e73de2fbc887fef"}
