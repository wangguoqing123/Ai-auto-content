{"material_id":"mat_5c40684bcc7d","source_platform":"aihot","source_kind":"news","collector":"aihot-v1","query_id":"","query_text":"","search_rank":null,"source_item_id":"jxpzj0z4beg1r0cktwzc0tmwe","identity_aliases":[],"source_access_status":"resolved","author_name":"IT之家·人工智能","author_followers":null,"title":"OpenAI 宣布 AI 模型取得三项科学突破，涉及局部光滑猜想、指数时间假设与杨–米尔斯理论","excerpt":"OpenAI 于 10 月 27 日宣布其 AI 模型在数学、计算机科学和物理学领域取得三项研究突破。数学上给出了所有维度下局部光滑猜想的证明，从而解决挂谷猜想与斯坦因限制猜想；计算机科学上给出推翻指数时间假设（ETH）的证明，暗示相关计算任务可能有更快算法；物理学上提出量子色动力学及标准模型一种统一完备化的严格存在性证明，涉及杨–米尔斯千禧年难题的一部分。","source_url":"https://www.ithome.com/1/018/203.htm","canonical_url":"https://www.ithome.com/1/018/203.htm","content_path":null,"content_downloaded":false,"published_at":"2026-10-26T23:37:17.237Z","published_at_quality":"exact","collected_at":"2026-10-27T06:04:15.888Z","engagement":{"views":null,"likes":null,"comments":null,"shares":null,"reposts":null,"quotes":null,"bookmarks":null,"collects":null},"metric_quality":"unavailable","usage_mode":"reference_only","viral_confidence":"unverified","status":"rejected","rejection_reasons":["low_relevance","below_overall_threshold"],"source_id":"aihot-selected-24h","source_name":"AIHOT 24 小时精选","source_type":"api","source_tier":"secondary","category":"ai_news","author":"IT之家·人工智能","language":"zh","target_users":["ai_beginner","intermediate_user"],"tags":["ai_news"],"relevance_score":25,"freshness_score":100,"evidence_score":70,"overall_score":55,"fingerprint":"5c40684bcc7d4fcadc372567365568f19d0781685664f4397450713261f1966e","content_fingerprint":"bc98f52849212881485f04e7f5d68a9c71ef87e7f2d94d33bc6851e6b156126d"}
