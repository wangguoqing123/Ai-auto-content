{"material_id":"mat_fb586a988ac8","source_platform":"aihot","source_kind":"news","collector":"aihot-v1","query_id":"","query_text":"","search_rank":null,"source_item_id":"cmta6v56y03yiroj2ki26viqh","identity_aliases":[],"source_access_status":"resolved","author_name":"Hacker News 热门（buzzing.cc 中文翻译）","author_followers":null,"title":"以色列资助的假美国智库试图利用AI进行宣传","excerpt":"一个打着\"汉诺威公共政策研究所\"旗号的亲以色列网站，在九天内发布了124篇、超56万字的报告，旨在优化内容以引导ChatGPT等AI聊天机器人引用其亲以观点。该网站由美国公司Piro Inc依据《外国代理人登记法》为以色列政府分发内容，其背后是以色列政府数千万美元资助、经Havas Media等第三方转手的更广泛宣传行动。","source_url":"https://www.theguardian.com/world/2026/aug/26/fake-thinktank-israel-ai-propaganda","canonical_url":"https://www.theguardian.com/world/2026/aug/26/fake-thinktank-israel-ai-propaganda","content_path":null,"content_downloaded":false,"published_at":"2026-08-26T14:05:28.706Z","published_at_quality":"exact","collected_at":"2026-08-27T11:00:21.699Z","engagement":{"views":null,"likes":null,"comments":null,"shares":null,"reposts":null,"quotes":null,"bookmarks":null,"collects":null},"metric_quality":"unavailable","usage_mode":"reference_only","viral_confidence":"unverified","status":"accepted","rejection_reasons":[],"source_id":"aihot-selected-24h","source_name":"AIHOT 24 小时精选","source_type":"api","source_tier":"secondary","category":"ai_news","author":"Hacker News 热门（buzzing.cc 中文翻译）","language":"zh","target_users":["ai_beginner","intermediate_user"],"tags":["actionable_update","ai_basics","ai_news","content_and_video"],"relevance_score":60,"freshness_score":100,"evidence_score":70,"overall_score":73,"fingerprint":"fb586a988ac87f509134abc8d7ba5a63d558d201c0a11a9b2ae002fa04255727","content_fingerprint":"68c039430dae4f264285716653bc349bb8c9af9cac709cc0678ddff35dbccc8f"}
{"material_id":"mat_7ce1ccb736e6","source_platform":"aihot","source_kind":"news","collector":"aihot-v1","query_id":"","query_text":"","search_rank":null,"source_item_id":"cmtaxja5w0ckaroamws5is8wp","identity_aliases":[],"source_access_status":"resolved","author_name":"Tomer Tunguz 博客（VC 分析）","author_followers":null,"title":"NVIDIA 季度营收指引达 1080 亿美元，首次突破单季千亿大关","excerpt":"NVIDIA 上季度营收 960 亿美元，同比增长 106%，并指引 Q3 营收达 1080 亿美元（±2%），成为首家单季营收破千亿的半导体公司。按此年化营收 4320 亿美元，NVIDIA 已跃居全球第六大公司。同时，非超大规模客户首次贡献数据中心净新增收入的大部分，应收账款周转天数从 45 天升至 60 天，显示其正通过延长付款条件为买家提供更多供应商融资。","source_url":"https://www.tomtunguz.com/nvidia-q2-fy27-earnings","canonical_url":"https://www.tomtunguz.com/nvidia-q2-fy27-earnings","content_path":null,"content_downloaded":false,"published_at":"2026-08-26T00:00:00.000Z","published_at_quality":"exact","collected_at":"2026-08-27T11:00:21.699Z","engagement":{"views":null,"likes":null,"comments":null,"shares":null,"reposts":null,"quotes":null,"bookmarks":null,"collects":null},"metric_quality":"unavailable","usage_mode":"reference_only","viral_confidence":"unverified","status":"rejected","rejection_reasons":["low_relevance","below_overall_threshold"],"source_id":"aihot-selected-24h","source_name":"AIHOT 24 小时精选","source_type":"api","source_tier":"secondary","category":"ai_news","author":"Tomer Tunguz 博客（VC 分析）","language":"zh","target_users":["ai_beginner","intermediate_user"],"tags":["ai_news"],"relevance_score":25,"freshness_score":80,"evidence_score":70,"overall_score":50,"fingerprint":"7ce1ccb736e6eac3c6fe130c20a15182aa146231476ccb4d9508c49bcebe3b46","content_fingerprint":"619f4c7be91eadbf5ddba89573e822fe36e6e3253a93921da7eb2ffd540994db"}
