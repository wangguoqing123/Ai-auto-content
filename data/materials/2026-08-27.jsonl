{"material_id":"mat_b9863581f526","source_platform":"aihot","source_kind":"news","collector":"aihot-v1","query_id":"","query_text":"","search_rank":null,"source_item_id":"cmta6v56y03ytroj25ggn7rlo","identity_aliases":[],"source_access_status":"resolved","author_name":"Hacker News 热门（buzzing.cc 中文翻译）","author_followers":null,"title":"C2PA相机经不起现实的考验：Android端可被root攻击伪造签名","excerpt":"安全研究员David Buchanan指出，C2PA相机认证在Android平台上可被攻破。通过root权限提升漏洞（如CVE-2026-43499），攻击者可利用StrongBox硬件签名任意数据，伪造C2PA签名图像和视频，且无需硬件攻击。该问题无法通过常规补丁修复，已提前90天向相关方报告。","source_url":"https://www.da.vidbuchanan.co.uk/blog/android-c2pa.html","canonical_url":"https://www.da.vidbuchanan.co.uk/blog/android-c2pa.html","content_path":null,"content_downloaded":false,"published_at":"2026-08-26T14:05:27.506Z","published_at_quality":"exact","collected_at":"2026-08-27T11:00:21.699Z","engagement":{"views":null,"likes":null,"comments":null,"shares":null,"reposts":null,"quotes":null,"bookmarks":null,"collects":null},"metric_quality":"unavailable","usage_mode":"reference_only","viral_confidence":"unverified","status":"rejected","rejection_reasons":["low_relevance"],"source_id":"aihot-selected-24h","source_name":"AIHOT 24 小时精选","source_type":"api","source_tier":"secondary","category":"ai_news","author":"Hacker News 热门（buzzing.cc 中文翻译）","language":"zh","target_users":["ai_beginner","intermediate_user"],"tags":["ai_news","content_and_video"],"relevance_score":40,"freshness_score":100,"evidence_score":70,"overall_score":63,"fingerprint":"b9863581f526cba41a95674151bd7a7f273f18fdc58e894a30a723edd6ddee1e","content_fingerprint":"af51747910e0fc3b8bd3d5bf0ee6f95fccddd04db06f2e7dde0460bcc72c0104"}
{"material_id":"mat_0d1232e8ef09","source_platform":"aihot","source_kind":"news","collector":"aihot-v1","query_id":"","query_text":"","search_rank":null,"source_item_id":"cmtaq20ih062wroamdrhb54b6","identity_aliases":[],"source_access_status":"resolved","author_name":"IT之家（RSS）","author_followers":null,"title":"英伟达 2027 财年半年报归母净利润 1180.1 亿美元，同比增长 161.1%","excerpt":"英伟达发布 2027 财年半年报，上半年营收 1778.37 亿美元，归母净利润 1180.1 亿美元，同比增长 161.1%，GAAP 毛利率 75%。第二财季营收 962.21 亿美元，同比增长 106%，环比增长 18%，归母净利润 596.88 亿美元，同比增长 126%。数据中心业务第二季度收入 890.23 亿美元，同比增长 117%，Vera Rubin 平台已进入全面量产。","source_url":"https://www.ithome.com/0/994/791.htm","canonical_url":"https://www.ithome.com/0/994/791.htm","content_path":null,"content_downloaded":false,"published_at":"2026-08-26T20:25:54.000Z","published_at_quality":"exact","collected_at":"2026-08-27T11:00:21.699Z","engagement":{"views":null,"likes":null,"comments":null,"shares":null,"reposts":null,"quotes":null,"bookmarks":null,"collects":null},"metric_quality":"unavailable","usage_mode":"reference_only","viral_confidence":"unverified","status":"rejected","rejection_reasons":["low_relevance"],"source_id":"aihot-selected-24h","source_name":"AIHOT 24 小时精选","source_type":"api","source_tier":"secondary","category":"ai_news","author":"IT之家（RSS）","language":"zh","target_users":["ai_beginner","intermediate_user"],"tags":["actionable_update","ai_news"],"relevance_score":35,"freshness_score":100,"evidence_score":70,"overall_score":60,"fingerprint":"0d1232e8ef09e5985a21656f752dc89a8ae2b501db1ee88e6a981a99de37b910","content_fingerprint":"c75a2e726bf39fcd515ea67cf02b7da5f9e808982525103dd5f0631d8c09bd33"}
