{"material_id":"mat_05cc66113318","source_platform":"aihot","source_kind":"news","collector":"aihot-v1","query_id":"","query_text":"","search_rank":null,"source_item_id":"cmtaj3732034urovudls0byfe","identity_aliases":[],"source_access_status":"resolved","author_name":"Google Research：Blog（网页）","author_followers":null,"title":"GlucoFM：面向连续血糖监测的基础模型","excerpt":"Google Research 推出 GlucoFM，一款轻量级自监督 CGM 基础模型，采用双流设计分别建模缓慢血糖趋势与短期波动。在四个队列、七项临床预测任务的 14 项评估中，其 PR-AUC 较最优 GluFormer 变体平均高出 5.8 个百分点，并在 PPGR 预测中取得最低 MAE。模型在 109，066 小时无标注 CGM 数据上预训练，具备跨数据集迁移与少样本适应能力。","source_url":"https://research.google/blog/glucofm-foundation-model-for-continuous-glucose-monitoring","canonical_url":"https://research.google/blog/glucofm-foundation-model-for-continuous-glucose-monitoring","content_path":null,"content_downloaded":false,"published_at":"2026-08-26T20:10:19.416Z","published_at_quality":"exact","collected_at":"2026-08-27T11:00:21.699Z","engagement":{"views":null,"likes":null,"comments":null,"shares":null,"reposts":null,"quotes":null,"bookmarks":null,"collects":null},"metric_quality":"unavailable","usage_mode":"reference_only","viral_confidence":"unverified","status":"rejected","rejection_reasons":["low_relevance","below_overall_threshold","low_level_only"],"source_id":"aihot-selected-24h","source_name":"AIHOT 24 小时精选","source_type":"api","source_tier":"secondary","category":"ai_news","author":"Google Research：Blog（网页）","language":"zh","target_users":["ai_beginner","intermediate_user"],"tags":["ai_news","low_level_research"],"relevance_score":0,"freshness_score":100,"evidence_score":70,"overall_score":43,"fingerprint":"05cc66113318e80dcc598b224d73646f450fbddd3fb93ba08e42f49658f5d091","content_fingerprint":"ffea057ea3f4e2c65e6580dd8f3cdd31781b391e301e57181684aa8ac49c3fec"}
