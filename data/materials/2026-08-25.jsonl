{"material_id":"mat_bc03a0c77f50","source_platform":"aihot","source_kind":"news","collector":"aihot-v1","query_id":"","query_text":"","search_rank":null,"source_item_id":"cmt7nq1d02bs1ro7373u88po4","identity_aliases":[],"source_access_status":"resolved","author_name":"Meta Engineering Blog（RSS）","author_followers":null,"title":"MetaRoCE：为 AI 规模以太网打造的全新 RDMA 传输协议","excerpt":"Meta 设计并开源了 MetaRoCE，一个专为 AI 工作负载在通用以太网上打造的 RDMA 传输协议，已通过 Open Compute Project（OCP）发布规范、参考软件实现和合规测试套件。该协议将智能移至端点，原生支持乱序交付、多路径、无损容忍和双向拥塞控制，无需 PFC，可在百万 GPU 规模下提供高吞吐、低尾延迟。现有 RDMA Verbs API 和软件栈无需修改即可运行。","source_url":"https://engineering.fb.com/2026/08/24/networking-traffic/metaroce-rdma-transport-ai-ethernet","canonical_url":"https://engineering.fb.com/2026/08/24/networking-traffic/metaroce-rdma-transport-ai-ethernet","content_path":null,"content_downloaded":false,"published_at":"2026-08-24T18:02:29.000Z","published_at_quality":"exact","collected_at":"2026-08-25T02:19:13.767Z","engagement":{"views":null,"likes":null,"comments":null,"shares":null,"reposts":null,"quotes":null,"bookmarks":null,"collects":null},"metric_quality":"unavailable","usage_mode":"reference_only","viral_confidence":"unverified","status":"rejected","rejection_reasons":["low_relevance"],"source_id":"aihot-selected-24h","source_name":"AIHOT 24 小时精选","source_type":"api","source_tier":"secondary","category":"ai_news","author":"Meta Engineering Blog（RSS）","language":"zh","target_users":["ai_beginner","intermediate_user"],"tags":["actionable_update","ai_news"],"relevance_score":35,"freshness_score":100,"evidence_score":70,"overall_score":60,"fingerprint":"bc03a0c77f5011fd44c8fe87459f917e8c75860ebcfa7c7708852a63160f9d22","content_fingerprint":"73bb193230e09dbc1725cda665c302d6bd43a486b37d6d1340fe85258d77afbd"}
