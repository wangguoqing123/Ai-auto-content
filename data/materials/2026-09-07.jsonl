{"material_id":"mat_c0c10a4c728b","source_platform":"aihot","source_kind":"news","collector":"aihot-v1","query_id":"","query_text":"","search_rank":null,"source_item_id":"cmtq5pxc10275roiufscxyie4","identity_aliases":[],"source_access_status":"resolved","author_name":"X：Rohan Paul (@rohanpaul_ai)","author_followers":null,"title":"OpenAI 宣布达到自动化研究实习生里程碑，内部 agent 运行时达人力 3.1 倍","excerpt":"OpenAI 发布内部数据称已达到自动化研究实习生里程碑，即可在人类监督下完成熟练研究员需数天的明确任务。截至 8 月中旬，其研究组织每投入 1 个人工工作日，就使用 3.1 个 agent 工作日的运行时长，该比值衡量的是运行时间而非等效生产力；原文作者援引 OpenAI 员工观点称递归自我改进或成为未来几年 AI 能力的关键，并呼吁其他 AI 公司同样公开数据。","source_url":"https://x.com/rohanpaul_ai/status/2096665545190043737","canonical_url":"https://x.com/rohanpaul_ai/status/2096665545190043737","content_path":null,"content_downloaded":false,"published_at":"2026-09-06T18:23:14.000Z","published_at_quality":"exact","collected_at":"2026-09-07T05:49:50.149Z","engagement":{"views":null,"likes":null,"comments":null,"shares":null,"reposts":null,"quotes":null,"bookmarks":null,"collects":null},"metric_quality":"unavailable","usage_mode":"reference_only","viral_confidence":"unverified","status":"accepted","rejection_reasons":[],"source_id":"aihot-selected-24h","source_name":"AIHOT 24 小时精选","source_type":"api","source_tier":"secondary","category":"ai_news","author":"X：Rohan Paul (@rohanpaul_ai)","language":"zh","target_users":["ai_beginner","intermediate_user"],"tags":["actionable_update","ai_basics","ai_news","automation"],"relevance_score":60,"freshness_score":100,"evidence_score":70,"overall_score":73,"fingerprint":"c0c10a4c728b3901070586356355f7123525c8ac92bddec9b389e3369d3d6852","content_fingerprint":"8709e0ae698297d9e7d014d3e1d7e0168e6ac4c40fad0fb05fe8e29a3cc4d922"}
