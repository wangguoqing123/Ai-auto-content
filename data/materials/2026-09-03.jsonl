{"material_id":"mat_4db2d4950487","source_platform":"aihot","source_kind":"news","collector":"aihot-v1","query_id":"","query_text":"","search_rank":null,"source_item_id":"cmtksft9f0450roali4sl0z86","identity_aliases":[],"source_access_status":"resolved","author_name":"IT之家（RSS）","author_followers":null,"title":"美国司法部介入纽约时报诉 OpenAI 案，主张 AI 训练属合理使用","excerpt":"美国司法部 9 月 1 日向曼哈顿联邦法院提交利益声明，介入《纽约时报》诉 OpenAI 版权案，支持 OpenAI 主张大语言模型训练属合理使用。DOJ 以国家安全和 AI 产业竞争力为主要论据，称训练使用具有转换性；《纽约时报》发言人批评政府站在 AI 公司一边牺牲创作者权益。法官要求双方最迟 9 月 4 日提交简易判决动议，该案结果可能为 AI 训练版权合法性确立先例。","source_url":"https://www.ithome.com/0/997/732.htm","canonical_url":"https://www.ithome.com/0/997/732.htm","content_path":null,"content_downloaded":false,"published_at":"2026-09-02T23:50:05.000Z","published_at_quality":"exact","collected_at":"2026-09-03T05:33:17.380Z","engagement":{"views":null,"likes":null,"comments":null,"shares":null,"reposts":null,"quotes":null,"bookmarks":null,"collects":null},"metric_quality":"unavailable","usage_mode":"reference_only","viral_confidence":"unverified","status":"rejected","rejection_reasons":["low_relevance","below_overall_threshold"],"source_id":"aihot-selected-24h","source_name":"AIHOT 24 小时精选","source_type":"api","source_tier":"secondary","category":"ai_news","author":"IT之家（RSS）","language":"zh","target_users":["ai_beginner","intermediate_user"],"tags":["ai_news"],"relevance_score":25,"freshness_score":100,"evidence_score":70,"overall_score":55,"fingerprint":"4db2d4950487b0bbc0f9f69da5d2740db9a9e5086b93cdeb4a991a0343d54baa","content_fingerprint":"7b41bc6e8bc35473cd16f9a96458f36dbd8a966437f7da633a8732e3f6dadfae"}
