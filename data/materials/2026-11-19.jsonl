{"material_id":"mat_e52923648569","source_platform":"aihot","source_kind":"news","collector":"aihot-v1","query_id":"","query_text":"","search_rank":null,"source_item_id":"abxhv94f3gcq1qb9mzdf7yma3","identity_aliases":[],"source_access_status":"resolved","author_name":"X：X.PIN (@thexpin)","author_followers":null,"title":"黄仁勋相关传闻核查：美商务部与司法部就Megaspeed发联合声明，未认定违规芯片销售","excerpt":"围绕英伟达前高管黄仁勋及AI芯片转运传闻，美国商务部与司法部就Megaspeed发布联合声明，未认定存在违规芯片销售，也未将该公司列入实体清单；英伟达此前已主动切断对Megaspeed的供应。相关声明未提及间谍行为，新加坡内政部亦表示未就间谍问题调查该公司负责人。","source_url":"https://x.com/thexpin/status/2123199944903581803","canonical_url":"https://x.com/thexpin/status/2123199944903581803","content_path":null,"content_downloaded":false,"published_at":"2026-11-18T23:41:28.000Z","published_at_quality":"exact","collected_at":"2026-11-19T08:30:56.254Z","engagement":{"views":null,"likes":null,"comments":null,"shares":null,"reposts":null,"quotes":null,"bookmarks":null,"collects":null},"metric_quality":"unavailable","usage_mode":"reference_only","viral_confidence":"unverified","status":"rejected","rejection_reasons":["low_relevance"],"source_id":"aihot-selected-24h","source_name":"AIHOT 24 小时精选","source_type":"api","source_tier":"secondary","category":"ai_news","author":"X：X.PIN (@thexpin)","language":"zh","target_users":["ai_beginner","intermediate_user"],"tags":["actionable_update","ai_news"],"relevance_score":35,"freshness_score":100,"evidence_score":70,"overall_score":60,"fingerprint":"e52923648569f0c125d0e245a325e8884244ed9165249cc5c58e955493e76370","content_fingerprint":"fa85cfd7889ed47cc634dc698c00eb041ec28f32d7f4c9609ff2a4f63546dd55"}
