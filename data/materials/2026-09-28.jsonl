{"material_id":"mat_4371ba12f4ed","source_platform":"aihot","source_kind":"news","collector":"aihot-v1","query_id":"","query_text":"","search_rank":null,"source_item_id":"prg6f1kih6agr1e57t7ikzckr","identity_aliases":[],"source_access_status":"resolved","author_name":"IT之家（RSS）","author_followers":null,"title":"Meta 推出 Hologram 拟真虚拟形象，秋季上线雷朋眼镜与 Quest 头显","excerpt":"Meta 宣布将于今年秋季在雷朋 Display 智能眼镜、Quest 头显及新轻薄头显上推出“Hologram”功能。该功能利用生成式 AI（实时扩散模型）创建高度拟真的用户虚拟形象，替代传统摄像头画面用于 WhatsApp 视频通话。用户需通过手机 Meta AI 应用采集面部表情和语音数据完成建模。雷朋版基于音频驱动生成 2D 视频流，Quest 版支持 3D 等身立体呈现。目前存在细节粗糙、侧倾变形等技术局限。","source_url":"https://www.ithome.com/1/007/767.htm","canonical_url":"https://www.ithome.com/1/007/767.htm","content_path":null,"content_downloaded":false,"published_at":"2026-09-28T04:31:04.000Z","published_at_quality":"exact","collected_at":"2026-09-28T06:27:25.780Z","engagement":{"views":null,"likes":null,"comments":null,"shares":null,"reposts":null,"quotes":null,"bookmarks":null,"collects":null},"metric_quality":"unavailable","usage_mode":"reference_only","viral_confidence":"unverified","status":"rejected","rejection_reasons":["low_relevance"],"source_id":"aihot-selected-24h","source_name":"AIHOT 24 小时精选","source_type":"api","source_tier":"secondary","category":"ai_news","author":"IT之家（RSS）","language":"zh","target_users":["ai_beginner","intermediate_user"],"tags":["ai_news","content_and_video"],"relevance_score":40,"freshness_score":100,"evidence_score":70,"overall_score":63,"fingerprint":"4371ba12f4ed89394b52bf86e04008fb19fe4d5caa8b5d0bcf7cd20224582460","content_fingerprint":"ce7971664478dca48eb28f4a3b76a2d19e91f3c8c7313b175fd55b79ae520a9e"}
