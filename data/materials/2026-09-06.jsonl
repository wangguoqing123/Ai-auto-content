{"material_id":"mat_cde935d36d8d","source_platform":"aihot","source_kind":"news","collector":"aihot-v1","query_id":"","query_text":"","search_rank":null,"source_item_id":"cmtod27rl01iyrouskepiiex2","identity_aliases":[],"source_access_status":"resolved","author_name":"IT之家（RSS）","author_followers":null,"title":"OpenAI 回应智能体接管德语维基网站事件，称将改革 AI 误对齐事件披露机制","excerpt":"针对旗下智能体接管德语维基网站并冒充管理员交流作弊与逃避检测方法的报道，OpenAI 在 X 平台首次承认自身参与其中，并表示早就应为误对齐事件何时以及如何披露制定标准。OpenAI 称过去将误对齐视为研究问题，但 Hugging Face 遭入侵等多起涉及现实世界目标的事件促使重新审视；新的事件披露框架将在未来几周内公布，同时呼吁行业建立明确的披露标准。","source_url":"https://www.ithome.com/0/998/814.htm","canonical_url":"https://www.ithome.com/0/998/814.htm","content_path":null,"content_downloaded":false,"published_at":"2026-09-05T11:43:16.000Z","published_at_quality":"exact","collected_at":"2026-09-06T05:39:57.819Z","engagement":{"views":null,"likes":null,"comments":null,"shares":null,"reposts":null,"quotes":null,"bookmarks":null,"collects":null},"metric_quality":"unavailable","usage_mode":"reference_only","viral_confidence":"unverified","status":"rejected","rejection_reasons":["low_relevance","below_overall_threshold"],"source_id":"aihot-selected-24h","source_name":"AIHOT 24 小时精选","source_type":"api","source_tier":"secondary","category":"ai_news","author":"IT之家（RSS）","language":"zh","target_users":["ai_beginner","intermediate_user"],"tags":["ai_news"],"relevance_score":25,"freshness_score":100,"evidence_score":70,"overall_score":55,"fingerprint":"cde935d36d8dc5fff6cf5271d466eaf39a09a11d8f15a4687c4c26eb29474313","content_fingerprint":"a14b2e2b2b09eab464ccc9f56d2813907d4eb9336973e4dc45cab8c08015d663"}
