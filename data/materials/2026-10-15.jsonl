{"material_id":"mat_40c8137255fe","source_platform":"aihot","source_kind":"news","collector":"aihot-v1","query_id":"","query_text":"","search_rank":null,"source_item_id":"pqpqgxyiu4qyu86fbljd726v9","identity_aliases":[],"source_access_status":"resolved","author_name":"MIT News（RSS）","author_followers":null,"title":"MIT团队用机器学习修正误差，将两到六周天气预报准确率翻倍","excerpt":"MIT研究人员团队在Nature发表论文，提出一个机器学习后处理层，通过从历史数据中学习现有预报模型的错误并修正其输出，将两周到六周范围的预报准确率翻倍。该模型在ECMWF的季节间预报竞赛中获第一名，首次在该时间范围内稳定超过气候学平均值，并显著改善洪水、寒潮等极端天气事件的预测；模型开源、低成本、可附加于任意预报模型，肯尼亚气象部门已接洽用于改进季风季预报。","source_url":"https://news.mit.edu/2026/researchers-improve-weather-forecasts-looking-two-six-weeks-out-1014","canonical_url":"https://news.mit.edu/2026/researchers-improve-weather-forecasts-looking-two-six-weeks-out-1014","content_path":null,"content_downloaded":false,"published_at":"2026-10-14T15:00:00.000Z","published_at_quality":"exact","collected_at":"2026-10-15T05:40:08.614Z","engagement":{"views":null,"likes":null,"comments":null,"shares":null,"reposts":null,"quotes":null,"bookmarks":null,"collects":null},"metric_quality":"unavailable","usage_mode":"reference_only","viral_confidence":"unverified","status":"rejected","rejection_reasons":["low_relevance","below_overall_threshold","low_level_only"],"source_id":"aihot-selected-24h","source_name":"AIHOT 24 小时精选","source_type":"api","source_tier":"secondary","category":"ai_news","author":"MIT News（RSS）","language":"zh","target_users":["ai_beginner","intermediate_user"],"tags":["ai_news","low_level_research"],"relevance_score":0,"freshness_score":100,"evidence_score":70,"overall_score":43,"fingerprint":"40c8137255fe9e48d14a7d1f7a869e514b6d59a3fd8ed8ecf96875764abf223e","content_fingerprint":"37a167833ca82302b2105ddc5be855c590e2eef0cefefa0d4d52f5ebfced29bc"}
